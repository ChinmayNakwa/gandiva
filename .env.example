# Generate fresh testnet wallets with: npm run wallets:new
# Never put mainnet keys here. This file is a template; the real values go in .env (gitignored).

# Hono API port (internal). The Next.js front door (client/) proxies to it.
PORT=4021
# Next.js front-door port (public). `npm start` points the tunnel here.
WEB_PORT=3000
# prod (default): `npm start` builds and serves the production web app. dev: `next dev` with hot reload.
WEB_MODE=prod
# Public HTTPS base URL. Leave empty to let `npm start` open a tunnel and fill it in.
PUBLIC_BASE_URL=
# auto (cloudflared, then ngrok) | cloudflared | ngrok | none
TUNNEL=auto
# Optional explicit binary paths (default: tools/<name>.exe, then PATH)
NGROK_PATH=
CLOUDFLARED_PATH=
# ngrok needs a free authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional free static domain from https://dashboard.ngrok.com/domains (keeps the public URL stable across restarts)
NGROK_DOMAIN=

FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Buyer agent (Scout) - the only key used at runtime
BUYER_PRIVATE_KEY=

# Seller payTo addresses (sellers only need an address to receive USDC)
PAYTO_SHELF_SCRAPER=
PAYTO_CHEAP_SCRAPER=
PAYTO_FX_RATES=
PAYTO_HINDI_SUMMARY=
PAYTO_JUNK_FX=
PAYTO_MIRROR_SCRAPER=
# Address the "mirror-scraper" demo seller wrongly puts in its 402 (payTo swap attack)
PAYTO_ATTACKER=

# LLM: local Ollama (OLLAMA_HOST=http://127.0.0.1:11434, OLLAMA_MODEL=qwen2.5:7b)
# or Ollama cloud (OLLAMA_HOST=https://ollama.com, a cloud model such as gpt-oss:20b, and an API key from ollama.com/settings/keys)
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Optional: require this token (header x-buyer-token) to make the buyer spend
BUYER_TOKEN=

# Register the adversarial demo sellers (greedy price, payTo swap, junk output)
SEED_ADVERSARIAL=true
